    "html": "<section style=\"position:absolute;left:374px;top:195px;width:842px;height:397px;box-sizing:border-box;background:#FFFDF5;border:2px solid #C9D8CC;border-radius:18px;padding:20px;color:#153D3A;font:19px 'Microsoft YaHei',sans-serif\" data-rain-lab=\"sim\"><style>*{box-sizing:border-box}p{margin:0}button{font:inherit;border:0;background:#153D3A;color:#FFFDF5;padding:11px 17px;border-radius:10px;cursor:pointer}button:focus-visible,input:focus-visible{outline:3px solid #E89755;outline-offset:3px}label{display:block}input[type=range]{width:100%;accent-color:#3978A8;height:30px}output{font-weight:bold} .metric{background:#E3EEDC;border-radius:10px;padding:13px}small{font-size:15px;color:#536B63}</style><div style=\"display:grid;grid-template-columns:270px minmax(0,1fr);gap:24px;height:100%\"><div><label for=\"rain-p\">降雨量 P　<output data-out=\"P\">30</output> mm</label><input id=\"rain-p\" data-param=\"P\" aria-label=\"降雨量P毫米\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"30\"><small>0 ～ 100 mm</small><label for=\"rain-f\" style=\"margin-top:15px\">硬化比例 f　<output data-out=\"f\">60</output>%</label><input id=\"rain-f\" data-param=\"f\" aria-label=\"硬化地面百分比\" type=\"range\" min=\"0\" max=\"100\" step=\"5\" value=\"60\"><small>0% ～ 100%（f = <span data-f-decimal=\"\">0.60</span>）</small><label for=\"rain-i\" style=\"margin-top:15px\">土壤入渗能力 I　<output data-out=\"I\">20</output> mm</label><input id=\"rain-i\" data-param=\"I\" aria-label=\"土壤本次最多入渗I毫米\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"20\"><small>0 ～ 100 mm / 本次降雨</small><button type=\"button\" data-record=\"\" style=\"margin-top:14px;width:100%\">＋ 记入证据本</button></div><div><p style=\"font-size:17px\">当前预览 · 100 m²</p><p style=\"font-size:22px;margin:8px 0 14px\">总雨量 <b data-total=\"\" style=\"font-size:32px;color:#3978A8\">3000</b> L</p><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px\"><div class=\"metric\"><p>↓ 入渗量</p><p style=\"font-size:30px;font-weight:bold;margin-top:7px\"><span data-infil=\"\">800</span> L</p></div><div class=\"metric\" style=\"background:#F3E0CB\"><p>→ 地表径流</p><p style=\"font-size:30px;font-weight:bold;margin-top:7px\"><span data-runoff=\"\">2200</span> L</p></div></div><div role=\"img\" data-waterbar=\"\" aria-label=\"入渗800升，径流2200升\" style=\"display:flex;height:28px;margin-top:16px;overflow:hidden;border-radius:8px;background:#DFE4DF\"><span data-infil-bar=\"\" style=\"width:26.667%;background:#6AAB83\"></span><span data-runoff-bar=\"\" style=\"width:73.333%;background:#E89755\"></span></div><p data-calc=\"\" style=\"font-size:17px;margin-top:12px;line-height:1.5\">入渗 = 0.40 × 20 × 100 = 800 L</p><p data-feedback=\"\" style=\"font-size:17px;margin-top:10px;line-height:1.5\">P 大于 I，土壤达到本次入渗上限。</p><p data-status=\"\" aria-live=\"polite\" style=\"font-size:16px;margin-top:11px;color:#3978A8\">尚无实验记录。预览不是实验经历。</p></div></div><script>/* 本局部实验由同对象 API5 作者入口连接正式共享状态。 */</script></section>",
