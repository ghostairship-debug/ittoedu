{
  "format": "guoling-component-library",
  "version": "1.2.0",
  "entry": {
    "schemaVersion": 1,
    "id": "com.ittoedu.language.pinyin-annotation",
    "title": "汉语拼音标注",
    "definitions": {
      "com.ittoedu.language.pinyin-annotation": {
        "id": "com.ittoedu.language.pinyin-annotation",
        "title": "汉语拼音标注",
        "version": "1.2.0",
        "role": "content",
        "implementation": {
          "kind": "source",
          "language": "javascript",
          "workspace": {
            "ownerId": "com.ittoedu.language.pinyin-annotation",
            "entry": "runtime.js"
          }
        },
        "dataSchema": {
          "type": "object",
          "properties": {
            "content": {
              "type": "object",
              "properties": {
                "title": {
                  "title": "标题",
                  "type": "string",
                  "maxLength": 60
                },
                "pairs": {
                  "title": "汉字与拼音",
                  "type": "string",
                  "description": "每个单元写成“汉字|带调拼音”，单元之间用空格分隔；换行会在课件中另起一行。标点可写成“，|”。",
                  "maxLength": 6000
                },
                "showAllLabel": {
                  "title": "显示拼音按钮",
                  "type": "string",
                  "maxLength": 30
                },
                "hideAllLabel": {
                  "title": "隐藏拼音按钮",
                  "type": "string",
                  "maxLength": 30
                }
              }
            },
            "hanziSize": {
              "title": "汉字字号",
              "type": "number",
              "minimum": 22,
              "maximum": 100,
              "multipleOf": 1
            },
            "pinyinSize": {
              "title": "拼音字号",
              "type": "number",
              "minimum": 22,
              "maximum": 52,
              "multipleOf": 1
            },
            "lineGap": {
              "title": "行间距",
              "type": "number",
              "minimum": 0,
              "maximum": 80,
              "multipleOf": 1
            },
            "unitGap": {
              "title": "字间距",
              "type": "number",
              "minimum": 0,
              "maximum": 40,
              "multipleOf": 1
            },
            "padding": {
              "title": "内边距",
              "type": "number",
              "minimum": 6,
              "maximum": 80,
              "multipleOf": 1
            },
            "showTitle": {
              "title": "显示标题",
              "type": "boolean"
            },
            "showPinyin": {
              "title": "显示拼音",
              "type": "boolean",
              "description": "关闭后保留拼音占位，汉字排版不会跳动。"
            },
            "showGlobalControls": {
              "title": "显示全局拼音按钮",
              "type": "boolean",
              "description": "在一个词组组件中显示“显示拼音／隐藏拼音”，控制同页全部拼音组件。"
            },
            "clickTogglesPinyin": {
              "title": "点击切换拼音",
              "type": "boolean",
              "description": "播放时点击本组件，可单独显示或隐藏这一词条的拼音。"
            },
            "hanziColor": {
              "title": "汉字颜色",
              "type": "string",
              "format": "color"
            },
            "pinyinColor": {
              "title": "拼音颜色",
              "type": "string",
              "format": "color"
            },
            "surface": {
              "title": "底色",
              "type": "string",
              "format": "color"
            },
            "borderColor": {
              "title": "边框颜色",
              "type": "string",
              "format": "color"
            }
          },
          "x-editor": {
            "presets": []
          }
        }
      }
    },
    "example": {
      "rootIds": [
        "example"
      ],
      "instances": {
        "example": {
          "id": "example",
          "definitionId": "com.ittoedu.language.pinyin-annotation",
          "data": {
            "content": {
              "ariaLabel": "汉语拼音标注",
              "title": "读准字音",
              "pairs": "朗|lǎng 润|rùn 酝|yùn 酿|niàng\n应|yìng 和|hè 黄|huáng 晕|yùn",
              "showAllLabel": "显示拼音",
              "hideAllLabel": "隐藏拼音"
            },
            "hanziSize": 48,
            "pinyinSize": 24,
            "lineGap": 28,
            "unitGap": 4,
            "padding": 32,
            "showTitle": true,
            "showPinyin": true,
            "showGlobalControls": false,
            "clickTogglesPinyin": false,
            "hanziColor": "#17324d",
            "pinyinColor": "#d94f3d",
            "surface": "#fffdf7",
            "borderColor": "#c9d9cd"
          },
          "frame": {
            "width": 960,
            "height": 280,
            "transform": [
              1,
              0,
              0,
              1,
              40,
              40
            ]
          }
        }
      }
    },
    "assets": {}
  },
  "resources": {
    "assets": {},
    "components": {
      "com.ittoedu.language.pinyin-annotation": {
        "runtime.js": "components/com.ittoedu.language.pinyin-annotation/runtime.js"
      }
    }
  },
  "metadata": {
    "description": "按可编辑的汉字与拼音配对文稿，在汉字上方稳定呈现带声调拼音"
  }
}
