{
  "format": "guoling-component-library",
  "version": "1.0.0",
  "entry": {
    "schemaVersion": 1,
    "id": "com.ittoedu.visual.image-frame",
    "title": "图片装饰容器",
    "definitions": {
      "com.ittoedu.visual.image-frame": {
        "id": "com.ittoedu.visual.image-frame",
        "title": "图片装饰容器",
        "version": "1.0.0",
        "role": "content",
        "implementation": {
          "kind": "source",
          "language": "javascript",
          "workspace": {
            "ownerId": "com.ittoedu.visual.image-frame",
            "entry": "runtime.js"
          }
        },
        "dataSchema": {
          "type": "object",
          "properties": {
            "visualStyle": {
              "title": "视觉样式",
              "type": "string",
              "oneOf": [
                {
                  "const": "brush",
                  "title": "笔刷"
                },
                {
                  "const": "sticker",
                  "title": "贴纸"
                }
              ]
            },
            "assetId": {
              "title": "展示图片",
              "type": "string",
              "format": "image-asset"
            },
            "content": {
              "type": "object",
              "properties": {
                "caption": {
                  "title": "图片标题",
                  "type": "string",
                  "maxLength": 100
                },
                "alt": {
                  "title": "无障碍说明",
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "showCaption": {
              "title": "显示图片标题",
              "type": "boolean"
            },
            "fit": {
              "title": "图片适配",
              "type": "string",
              "oneOf": [
                {
                  "const": "cover",
                  "title": "裁切铺满"
                },
                {
                  "const": "contain",
                  "title": "完整显示"
                }
              ]
            },
            "positionX": {
              "title": "图片水平焦点",
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "multipleOf": 1
            },
            "positionY": {
              "title": "图片垂直焦点",
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "multipleOf": 1
            },
            "captionSize": {
              "title": "标题字号",
              "type": "number",
              "minimum": 22,
              "maximum": 64,
              "multipleOf": 1
            },
            "captionColor": {
              "title": "标题颜色",
              "type": "string",
              "format": "color"
            },
            "accentColor": {
              "title": "强调颜色",
              "type": "string",
              "format": "color"
            },
            "borderWidth": {
              "title": "贴纸白边",
              "type": "number",
              "minimum": 0,
              "maximum": 28,
              "multipleOf": 1
            },
            "borderColor": {
              "title": "贴纸纸边颜色",
              "type": "string",
              "format": "color"
            },
            "shadowEnabled": {
              "title": "显示投影",
              "type": "boolean"
            },
            "shadowOpacity": {
              "title": "投影强度",
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "multipleOf": 0.02
            },
            "shadowDistance": {
              "title": "投影距离",
              "type": "number",
              "minimum": 0,
              "maximum": 30,
              "multipleOf": 1
            }
          },
          "required": [
            "visualStyle",
            "fit"
          ],
          "x-editor": {
            "presets": [
              {
                "id": "brush",
                "label": "笔刷图片",
                "data": {
                  "visualStyle": "brush",
                  "fit": "cover",
                  "showCaption": true
                }
              },
              {
                "id": "sticker",
                "label": "贴纸图片",
                "data": {
                  "visualStyle": "sticker",
                  "fit": "contain",
                  "showCaption": false
                }
              }
            ]
          }
        }
      }
    },
    "example": {
      "rootIds": [
        "example"
      ],
      "instances": {
        "example": {
          "id": "example",
          "definitionId": "com.ittoedu.visual.image-frame",
          "data": {
            "content": {
              "caption": "图片标题",
              "alt": "装饰图片"
            },
            "visualStyle": "brush",
            "fit": "cover",
            "positionX": 50,
            "positionY": 50,
            "showCaption": true,
            "captionSize": 28,
            "captionColor": "#2f6f4e",
            "accentColor": "#d95d42",
            "borderWidth": 12,
            "borderColor": "#fffdf6",
            "shadowEnabled": true,
            "shadowOpacity": 0.22,
            "shadowDistance": 12,
            "assetId": ""
          },
          "frame": {
            "width": 760,
            "height": 520,
            "transform": [
              1,
              0,
              0,
              1,
              40,
              40
            ]
          }
        }
      }
    },
    "assets": {}
  },
  "resources": {
    "assets": {},
    "components": {
      "com.ittoedu.visual.image-frame": {
        "runtime.js": "components/com.ittoedu.visual.image-frame/runtime.js"
      }
    }
  },
  "metadata": {
    "description": "统一承载笔刷裁切和贴纸白边等图片装饰样式"
  }
}
