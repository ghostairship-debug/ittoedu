{
  "format": "guoling-component-library",
  "version": "1.0.0",
  "entry": {
    "schemaVersion": 1,
    "id": "com.ittoedu.visual.text-container",
    "title": "文字视觉容器",
    "definitions": {
      "com.ittoedu.visual.text-container": {
        "id": "com.ittoedu.visual.text-container",
        "title": "文字视觉容器",
        "version": "1.0.0",
        "role": "content",
        "implementation": {
          "kind": "source",
          "language": "javascript",
          "workspace": {
            "ownerId": "com.ittoedu.visual.text-container",
            "entry": "runtime.js"
          }
        },
        "dataSchema": {
          "type": "object",
          "properties": {
            "visualStyle": {
              "title": "视觉样式",
              "type": "string",
              "oneOf": [
                {
                  "const": "transparent-glass",
                  "title": "透明玻璃"
                },
                {
                  "const": "frosted-glass",
                  "title": "磨砂玻璃"
                },
                {
                  "const": "sticky-note",
                  "title": "便利贴"
                },
                {
                  "const": "torn-paper",
                  "title": "撕纸"
                },
                {
                  "const": "file-folder",
                  "title": "文件夹"
                }
              ]
            },
            "content": {
              "type": "object",
              "properties": {
                "eyebrow": {
                  "title": "眉题",
                  "type": "string",
                  "maxLength": 100
                },
                "title": {
                  "title": "标题",
                  "type": "string",
                  "maxLength": 120
                },
                "body": {
                  "title": "正文",
                  "type": "string",
                  "maxLength": 5000
                },
                "steps": {
                  "title": "步骤",
                  "type": "string",
                  "description": "每行一个步骤。",
                  "maxLength": 1000
                }
              }
            },
            "showEyebrow": {
              "title": "显示眉题",
              "type": "boolean"
            },
            "showTitle": {
              "title": "显示标题",
              "type": "boolean"
            },
            "showBody": {
              "title": "显示正文",
              "type": "boolean"
            },
            "showSteps": {
              "title": "显示步骤",
              "type": "boolean"
            },
            "padding": {
              "title": "内边距",
              "type": "number",
              "minimum": 12,
              "maximum": 100,
              "multipleOf": 1
            },
            "eyebrowSize": {
              "title": "眉题字号",
              "type": "number",
              "minimum": 22,
              "maximum": 48,
              "multipleOf": 1
            },
            "titleSize": {
              "title": "标题字号",
              "type": "number",
              "minimum": 22,
              "maximum": 80,
              "multipleOf": 1
            },
            "bodySize": {
              "title": "正文字号",
              "type": "number",
              "minimum": 22,
              "maximum": 72,
              "multipleOf": 1
            },
            "stepSize": {
              "title": "步骤字号",
              "type": "number",
              "minimum": 22,
              "maximum": 56,
              "multipleOf": 1
            },
            "lineHeight": {
              "title": "正文行高",
              "type": "number",
              "minimum": 1.1,
              "maximum": 2.5,
              "multipleOf": 0.05
            },
            "textColor": {
              "title": "文字颜色",
              "type": "string",
              "format": "color"
            },
            "accentColor": {
              "title": "强调颜色",
              "type": "string",
              "format": "color"
            },
            "shadowOpacity": {
              "title": "阴影强度",
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "multipleOf": 0.02
            }
          },
          "required": [
            "visualStyle"
          ],
          "x-editor": {
            "presets": [
              {
                "id": "glass",
                "label": "玻璃信息卡",
                "data": {
                  "visualStyle": "transparent-glass",
                  "showEyebrow": false,
                  "showSteps": false
                }
              },
              {
                "id": "note",
                "label": "便利贴提示",
                "data": {
                  "visualStyle": "sticky-note",
                  "showEyebrow": true,
                  "showSteps": false
                }
              },
              {
                "id": "task-folder",
                "label": "文件夹任务卡",
                "data": {
                  "visualStyle": "file-folder",
                  "showEyebrow": true,
                  "showSteps": true
                }
              }
            ]
          }
        }
      }
    },
    "example": {
      "rootIds": [
        "example"
      ],
      "instances": {
        "example": {
          "id": "example",
          "definitionId": "com.ittoedu.visual.text-container",
          "data": {
            "content": {
              "eyebrow": "课堂提示",
              "title": "标题",
              "body": "在这里输入内容",
              "steps": "步骤一\n步骤二"
            },
            "visualStyle": "transparent-glass",
            "showEyebrow": false,
            "showTitle": true,
            "showBody": true,
            "showSteps": false,
            "padding": 42,
            "eyebrowSize": 22,
            "titleSize": 34,
            "bodySize": 28,
            "stepSize": 24,
            "lineHeight": 1.65,
            "textColor": "#173d2a",
            "accentColor": "#d95d42",
            "shadowOpacity": 0.2
          },
          "frame": {
            "width": 860,
            "height": 480,
            "transform": [
              1,
              0,
              0,
              1,
              40,
              40
            ]
          }
        }
      }
    },
    "assets": {}
  },
  "resources": {
    "assets": {},
    "components": {
      "com.ittoedu.visual.text-container": {
        "runtime.js": "components/com.ittoedu.visual.text-container/runtime.js"
      }
    }
  },
  "metadata": {
    "description": "统一承载玻璃、便利贴、撕纸和文件夹等文字视觉样式"
  }
}
