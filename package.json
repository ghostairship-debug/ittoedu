{
  "name": "ittoedu-courseware-editor",
  "version": "0.0.1",
  "description": "果铃工作台：可编辑课件与 AI 内容创作工作台",
  "main": "dist-electron/main/index.js",
  "author": "ittoedu",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "install:courseware-skills": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-courseware-skills.ps1",
    "prestart": "npm run install:courseware-skills",
    "predev": "npm run build:player && npm run build:electron",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 tsx scripts/launch-electron.ts .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "pretest": "npm run build:player",
    "test": "vitest run",
    "pretest:product": "npm run build:player",
    "test:product": "vitest run --exclude=tests/unit/taskBoardGenerator.test.ts --exclude=tests/unit/aiCapabilities.test.ts",
    "test:governance": "vitest run tests/unit/taskBoardGenerator.test.ts",
    "test:capabilities": "vitest run tests/unit/aiCapabilities.test.ts",
    "pretest:e2e": "npm run build:player && npm run check:examples && npm run prepare:lesson-demo:fixture && npm run build:component-catalog-matrix:fixture && npm run build:renderer && npm run build:electron",
    "test:e2e": "playwright test",
    "test:e2e:visible": "cross-env COURSEWARE_E2E_BACKGROUND=0 npm run test:e2e",
    "build:player": "vite build --config vite.player.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "start:quick": "node scripts/prepare-source-launch.mjs && cross-env VITE_DEV_SERVER_URL= tsx scripts/launch-electron.ts .",
    "mcp:server": "tsx scripts/launch-mcp-server.ts",
    "mcp:connect": "tsx scripts/connect-mcp.ts",
    "build:file-publish-helper": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-file-publish-helper.ps1",
    "build:clipboard-helper": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-clipboard-helper.ps1",
    "build:built-in-components": "node resources/built-in-components/scripts/build-components.mjs",
    "check:built-in-components": "node resources/built-in-components/scripts/build-components.mjs --check",
    "build:desktop": "npm run check:built-in-components && npm run build:clipboard-helper && npm run build:file-publish-helper && npm run build:player && npm run build:renderer && npm run build:electron",
    "start": "npm run build:desktop && cross-env VITE_DEV_SERVER_URL= tsx scripts/launch-electron.ts .",
    "start:engineering": "npm run build:desktop && cross-env VITE_DEV_SERVER_URL= tsx scripts/launch-electron.ts . --engineering-oauth-profile",
    "generate:ai-capabilities": "tsx scripts/generate-ai-capabilities.ts",
    "check:core-experience-validation": "tsx scripts/check-core-experience-validation.ts",
    "check:ai-capabilities": "tsx scripts/generate-ai-capabilities.ts --check",
    "generate:contracts": "tsx scripts/generate-contracts.ts",
    "generate:component-sources": "tsx scripts/generate-component-builtin-sources.ts",
    "prebuild:renderer": "npm run generate:component-sources",
    "prebuild:electron": "npm run generate:component-sources",
    "check:contracts": "tsx scripts/generate-contracts.ts --check",
    "generate:task-board": "tsx scripts/generate-task-board.ts",
    "check:task-board": "tsx scripts/generate-task-board.ts --check",
    "check:development-roadmap:historical": "tsx scripts/check-development-roadmap.ts --historical",
    "check:preservation:historical": "tsx scripts/check-preservation.ts",
    "check:legacy-inventory": "tsx scripts/check-legacy-consumers.ts --mode ratchet",
    "check:legacy-ready": "tsx scripts/check-legacy-consumers.ts --mode ready",
    "check:legacy-zero": "tsx scripts/check-legacy-consumers.ts --mode zero",
    "check:g20-import-boundaries": "tsx scripts/check-g20-import-boundaries.ts",
    "check:renderer-fonts": "tsx scripts/check-renderer-font-assets.ts",
    "test:renderer-fonts": "npm run build:player && npm run build:renderer && npm run check:renderer-fonts",
    "validate:course-project": "tsx scripts/validate-project.ts",
    "validate:project": "tsx scripts/validate-project.ts",
    "validate:historical-v9": "tsx scripts/historical/validate-course-project-v9.ts",
    "build:courseware-case": "tsx scripts/build-courseware-case.ts",
    "run-courseware-authoring": "tsx scripts/run-courseware-authoring.ts",
    "build": "npm run check:ai-capabilities && npm run typecheck && npm run test && npm run build:desktop",
    "dist:win": "npm run build && electron-builder --win portable dir --x64",
    "verify": "npm run check:ai-capabilities && npm run check:contracts && npm run check:task-board && npm run typecheck && npm run test && npm run test:e2e",
    "refresh:examples": "npm run build:player && npm run refresh:sample-examples && npm run refresh:lesson-demo:fixture && npm run refresh:render-benchmark:fixture",
    "check:examples": "npm run check:sample-examples && npm run check:lesson-demo:fixture && npm run check:render-benchmark:fixture",
    "refresh:sample-examples": "tsx scripts/build-examples.ts --refresh",
    "check:sample-examples": "tsx scripts/build-examples.ts --check",
    "build:examples": "npm run refresh:sample-examples",
    "build:lesson-demo": "npm run build:player && npm run build:lesson-demo:fixture",
    "refresh:lesson-demo:fixture": "tsx scripts/build-interactive-lesson.ts --refresh",
    "check:lesson-demo:fixture": "tsx scripts/build-interactive-lesson.ts --check",
    "prepare:lesson-demo:fixture": "tsx scripts/build-interactive-lesson.ts --prepare",
    "build:lesson-demo:fixture": "npm run refresh:lesson-demo:fixture",
    "build:render-benchmark": "npm run build:player && npm run build:render-benchmark:fixture",
    "refresh:render-benchmark:fixture": "tsx scripts/build-render-host-benchmark.ts --refresh",
    "check:render-benchmark:fixture": "tsx scripts/build-render-host-benchmark.ts --check",
    "build:render-benchmark:fixture": "npm run refresh:render-benchmark:fixture",
    "build:component-catalog-matrix": "npm run build:player && npm run build:component-catalog-matrix:fixture",
    "build:component-catalog-matrix:fixture": "tsx scripts/build-component-catalog-matrix.ts",
    "test:component-catalog-matrix": "npm run build:player && npm run build:renderer && npm run build:electron && vitest run tests/unit/l0VisibleComponentCatalog.test.tsx tests/integration/componentPackageReplacementRace.test.tsx tests/unit/l0LibraryClosure.test.tsx tests/unit/l0LibraryIdentityReferences.test.ts tests/unit/componentCompilerQ1.test.ts && playwright test tests/e2e/componentDeliveryFormats.spec.ts tests/e2e/publishedComponentRuntime.spec.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "verify:component-catalog": "tsx scripts/verify-component-catalog.ts",
    "verify:release": "npm run verify && tsx scripts/verify-release.ts",
    "verify:w3-portability": "npm run build:player && tsx scripts/verify-w3-windows-portability.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "1.8.0",
    "@playwright/mcp": "0.0.83",
    "@xmldom/xmldom": "0.8.13",
    "acorn": "8.18.0",
    "cfb": "1.2.2",
    "docx": "9.8.1",
    "entities": "8.0.0",
    "esbuild": "0.28.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "grapesjs": "0.23.6",
    "immer": "11.1.15",
    "katex": "0.18.7",
    "lucide-react": "1.25.0",
    "marked": "17.0.6",
    "mermaid": "^11.17.2",
    "nanoid": "6.0.0",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "phaser": "4.2.0",
    "pptxgenjs": "4.0.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "undici": "7.28.0",
    "xlsx-calc": "0.9.2",
    "yaml": "2.9.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "30.0.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "fontkit": "^2.0.4",
    "jsdom": "29.1.1",
    "png-to-ico": "3.0.2",
    "three": "0.185.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  }
}
