{
  "description": "对同页同展示状态的已观察对象做对齐、等距分布或Flow正文分栏。targets用对象句柄；intent.kind=columns将同一正文父级内对象编入分栏，可用columns按这些句柄分列、ratios设列宽、gap设间距。软件保留对象身份、内容和人工样式，准备布局及正式事务，一次撤销。对齐与分布复用世界坐标、父级逆变换和锁定规则，无需逐个计算frame。",
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "minLength": 1,
        "type": "string"
      },
      "__schema1": {
        "items": {
          "$ref": "#/$defs/__schema0"
        },
        "type": "array"
      },
      "__schema2": {
        "exclusiveMinimum": 0,
        "type": "number"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "intent": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "alignment": {
                "enum": [
                  "left",
                  "center",
                  "right",
                  "top",
                  "middle",
                  "bottom"
                ],
                "type": "string"
              },
              "kind": {
                "const": "align",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "alignment"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "axis": {
                "enum": [
                  "horizontal",
                  "vertical"
                ],
                "type": "string"
              },
              "kind": {
                "const": "distribute",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "axis"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "columns": {
                "items": {
                  "$ref": "#/$defs/__schema1"
                },
                "minItems": 2,
                "type": "array"
              },
              "gap": {
                "minimum": 0,
                "type": "number"
              },
              "kind": {
                "const": "columns",
                "type": "string"
              },
              "ratios": {
                "items": {
                  "$ref": "#/$defs/__schema2"
                },
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "targets": {
        "items": {
          "$ref": "#/$defs/__schema0"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "targets",
      "intent"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "对齐与分布",
    "targetKinds": [
      "course-instance"
    ]
  },
  "name": "object.layout",
  "version": 1
}
