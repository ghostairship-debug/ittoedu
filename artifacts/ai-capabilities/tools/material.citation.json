{
  "candidateCarrier": {
    "default": "native"
  },
  "examples": [
    {
      "bindings": "values 的 title/text/source/id/workspace/createdAt 来自当前观察、已读资源或用户要求，值须满足本卡 inputSchema；destination 原样复制当前目标。",
      "code": "const input={\"title\":values[\"title\"],\"text\":values[\"text\"],\"source\":values[\"source\"],\"version\":1,\"id\":values[\"id\"],\"workspace\":values[\"workspace\"],\"createdAt\":values[\"createdAt\"]}; const receipt=await session.execute(\"material.citation\",input,destination);"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "createdAt": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "id": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
      },
      "source": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "text",
                "type": "string"
              },
              "locator": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "locator"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "file",
                "type": "string"
              },
              "locator": {
                "maxLength": 32767,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "locator"
            ],
            "type": "object"
          }
        ]
      },
      "text": {
        "maxLength": 2097152,
        "minLength": 1,
        "type": "string"
      },
      "title": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "version": {
        "const": 1,
        "type": "number"
      },
      "workspace": {
        "additionalProperties": false,
        "properties": {
          "normalizedPath": {
            "maxLength": 32767,
            "minLength": 1,
            "type": "string"
          },
          "projectId": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "const": 1,
            "type": "number"
          }
        },
        "required": [
          "version",
          "projectId",
          "normalizedPath"
        ],
        "type": "object"
      }
    },
    "required": [
      "title",
      "text",
      "source",
      "version",
      "id",
      "workspace",
      "createdAt"
    ],
    "type": "object"
  },
  "invocation": "Builder: await session.execute(tool,input,destination)。input 遵循本卡完整 Schema；destination 原样使用当前 observe/createScope 的目标；只以 committed receipt 判定成功。",
  "name": "material.citation",
  "recovery": "invalid-input: 按本卡 Schema 修正字段；revision-conflict: 重新 observe 后复制新 target 和源码基线；tool-failed: 读取 diagnostics 修复所指输入/资源/宿主条件，失败不代表已提交。",
  "support": "conditional-on-input-target-resources-and-host",
  "supportedScopes": [
    "slide:scene",
    "slide:global",
    "flow:surface",
    "flow:global",
    "spatial-2d:world",
    "spatial-2d:global"
  ],
  "variants": [
    {
      "scopes": [
        "slide:scene",
        "slide:global",
        "flow:surface",
        "flow:global",
        "spatial-2d:world",
        "spatial-2d:global"
      ]
    }
  ],
  "version": 1
}
