{
  "description": "修改获授权整对象的公开属性。使用 target 句柄，或使用 project.list/read 返回的对象 path；project 可选。data/style 只修改提供字段，省略字段和人工位置保持；专业 appearance/style 等子记录可局部修改，数组和正文仍使用该字段完整值。implementation 是实例源码覆盖或 null 恢复默认，不能充当专业类型转换；frame 可局部调位置尺寸。文字范围授权不能扩大为整对象。",
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/$defs/__schema3",
            "description": "Only supplied data properties change; omitted properties are preserved. Professional appearance, sizing, style, crop, feather, filters and poster records accept partial properties. Arrays and content values use their existing complete-value format."
          },
          "frame": {
            "additionalProperties": false,
            "properties": {
              "height": {
                "$ref": "#/$defs/__schema1",
                "exclusiveMinimum": 0
              },
              "width": {
                "$ref": "#/$defs/__schema1",
                "exclusiveMinimum": 0
              },
              "x": {
                "$ref": "#/$defs/__schema1"
              },
              "y": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "type": "object"
          },
          "implementation": {
            "$ref": "#/$defs/__schema5",
            "description": "源码只需 source 正文或 from 文件路径；省略 language 保留现有语言。null 恢复定义实现。workspace、模块和资源绑定由软件维护。"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "locked": {
            "type": "boolean"
          },
          "opacity": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "playbackInitialVisibility": {
            "enum": [
              "inherit",
              "hidden"
            ],
            "type": "string"
          },
          "rotation": {
            "$ref": "#/$defs/__schema1"
          },
          "style": {
            "additionalProperties": {
              "$ref": "#/$defs/__schema3"
            },
            "description": "Only supplied style properties change; omitted properties are preserved. Use null to explicitly clear a CSS value.",
            "propertyNames": {
              "$ref": "#/$defs/__schema4"
            },
            "type": "object"
          },
          "visible": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "__schema1": {
        "type": "number"
      },
      "__schema2": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "items": {
              "$ref": "#/$defs/__schema3"
            },
            "type": "array"
          },
          {
            "additionalProperties": {
              "$ref": "#/$defs/__schema3"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        ]
      },
      "__schema3": {
        "$ref": "#/$defs/__schema2"
      },
      "__schema4": {
        "type": "string"
      },
      "__schema5": {
        "anyOf": [
          {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "source",
                    "type": "string"
                  },
                  "language": {
                    "enum": [
                      "javascript",
                      "typescript"
                    ],
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "source"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "source",
                    "type": "string"
                  },
                  "language": {
                    "enum": [
                      "javascript",
                      "typescript"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "from"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "builtin",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "key"
                ],
                "type": "object"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "additionalProperties": false,
        "properties": {
          "properties": {
            "$ref": "#/$defs/__schema0"
          },
          "target": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "target",
          "properties"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "project": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "properties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "path",
          "properties"
        ],
        "type": "object"
      }
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "修改属性",
    "targetKinds": [
      "course-instance"
    ]
  },
  "name": "object.update",
  "version": 1
}
