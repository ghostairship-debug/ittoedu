          },
          "limit": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "page": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "allowShareAlike": {
            "type": "boolean"
          },
          "limit": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "page": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      }
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
