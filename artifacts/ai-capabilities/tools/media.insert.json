        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "__schema1": {
        "enum": [
          "contain",
          "cover",
          "stretch"
        ],
        "type": "string"
      },
      "__schema2": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "$ref": "#/$defs/__schema3",
            "exclusiveMinimum": 0
          },
          "transform": {
            "prefixItems": [
              {
                "$ref": "#/$defs/__schema3"
              },
              {
                "$ref": "#/$defs/__schema3"
              },
              {
                "$ref": "#/$defs/__schema3"
              },
              {
                "$ref": "#/$defs/__schema3"
              },
              {
                "$ref": "#/$defs/__schema3"
              },
              {
                "$ref": "#/$defs/__schema3"
              }
            ],
            "type": "array"
          },
          "width": {
            "$ref": "#/$defs/__schema3",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "width",
          "height",
          "transform"
        ],
        "type": "object"
      },
      "__schema3": {
        "type": "number"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "additionalProperties": false,
        "properties": {
          "fit": {
            "$ref": "#/$defs/__schema1"
          },
          "frame": {
            "$ref": "#/$defs/__schema2"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "target",
          "source"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "fit": {
            "$ref": "#/$defs/__schema1"
          },
          "frame": {
            "$ref": "#/$defs/__schema2"
          },
          "resource": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "target",
          "resource"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "fit": {
            "$ref": "#/$defs/__schema1"
          },
          "frame": {
            "$ref": "#/$defs/__schema2"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "project": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "source"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "fit": {
            "$ref": "#/$defs/__schema1"
          },
          "frame": {
            "$ref": "#/$defs/__schema2"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "project": {
            "minLength": 1,
            "type": "string"
          },
          "resource": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
