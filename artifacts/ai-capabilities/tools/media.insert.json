  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "插入媒体",
    "targetKinds": [
      "course-surface"
    ]
  },
  "name": "media.insert",
  "version": 1
