{
  "candidateCarrier": {
    "default": "runtime"
  },
  "description": "修改现有 Runtime 的完整 source，使用观察中该对象的原 update target；保留实例ID、位置、尺寸、绑定和未指定字段。省略 staticFallback 时保留原后备；需修复或更新后备图片时可同时指定 strict {assetId,coverage}（coverage 为 scene 或 surface），先经 asset.media.import 导入有效图片，再用其 asset-id 回执引用。source 与后备在同一事务更新；仅换后备时仍提供当前完整 source。速度或机制修改无需新建或 selection.replace，所有修改仍须完整资源闭包与真实宿主准入。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "source": {
        "maxLength": 2000000,
        "minLength": 1,
        "type": "string"
      },
      "staticFallback": {
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "coverage": {
            "enum": [
              "surface",
              "scene"
            ],
            "type": "string"
          }
        },
        "required": [
          "assetId",
          "coverage"
        ],
        "type": "object"
      }
    },
    "required": [
      "source"
    ],
    "type": "object"
  },
  "name": "runtime.source",
  "support": "conditional-on-input-target-resources-and-host",
  "supportedScopes": [
    "slide:scene",
    "slide:global",
    "flow:surface"
  ],
  "version": 1
}
