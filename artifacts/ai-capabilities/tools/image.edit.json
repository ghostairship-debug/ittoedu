{
  "description": "编辑图片，或用一张/多张真实参考图创作下一幅。references 原样传已授权的 source/resource、材料或工程整张图片句柄；参考与 target 独立。省略 application 返回候选；用户明确编辑并插入/替换时传 application:{mode:insert|replace,target:已观察句柄}，软件冻结目标并正式应用，保全同期人工修改与晚到候选。宿主读取原字节并使用冻结图片连接，不承诺绝对一致，未知结果不自动重发。",
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "minLength": 1,
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "application": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "insert",
              "replace"
            ],
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "mode",
          "target"
        ],
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "properties": {
          "background": {
            "enum": [
              "auto",
              "opaque",
              "transparent"
            ],
            "type": "string"
          },
          "format": {
            "const": "png",
            "type": "string"
          },
          "quality": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "size": {
            "anyOf": [
              {
                "const": "auto",
                "type": "string"
              },
              {
                "pattern": "^\\d{2,5}x\\d{2,5}$",
                "type": "string"
              }
            ]
          }
        },
        "type": "object"
      },
      "prompt": {
        "minLength": 1,
        "type": "string"
      },
      "references": {
        "items": {
          "$ref": "#/$defs/__schema0"
        },
        "minItems": 1,
        "type": "array"
      },
      "target": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "required": [
      "prompt",
      "references"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "image.edit",
    "targetKinds": [
      "document",
      "course-surface",
      "course-instance"
    ]
  },
  "name": "image.edit",
  "version": 1
}
