{
  "description": "编辑已有图片。references 原样传入返回的 source/resource，或当前文档的整张专业图片/图片素材句柄。宿主读取原字节并使用冻结连接。返回资源须经 project.apply 或 media.apply 正式应用；未知结果不自动重发。",
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "minLength": 1,
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "output": {
        "additionalProperties": false,
        "properties": {
          "background": {
            "enum": [
              "auto",
              "opaque",
              "transparent"
            ],
            "type": "string"
          },
          "format": {
            "const": "png",
            "type": "string"
          },
          "quality": {
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "size": {
            "anyOf": [
              {
                "const": "auto",
                "type": "string"
              },
              {
                "pattern": "^\\d{2,5}x\\d{2,5}$",
                "type": "string"
              }
            ]
          }
        },
        "type": "object"
      },
      "prompt": {
        "minLength": 1,
        "type": "string"
      },
      "references": {
        "items": {
          "$ref": "#/$defs/__schema0"
        },
        "minItems": 1,
        "type": "array"
      },
      "target": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "required": [
      "prompt",
      "references"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "image.edit",
    "targetKinds": [
      "document",
      "course-surface",
      "course-instance"
    ]
  },
  "name": "image.edit",
  "version": 1
}
