{
  "description": "完整复制已观察参考页，再替换 surface.remix.inspect 返回的正文槽位。可同次指定新页 title 与 placement=end，省去复制后的改名和移动；省略时仍放在参考页后。保留人工布局、富文本、互动、展示状态与内部引用，软件维护复制身份；需要整课写入授权。",
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "type": "string"
      },
      "__schema1": {
        "enum": [
          "after-reference",
          "end"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "placement": {
        "$ref": "#/$defs/__schema1",
        "description": "默认在参考页后插入；end 放到参考页所在容器末尾，保持其他页面顺序。"
      },
      "replacements": {
        "additionalProperties": {
          "type": "string"
        },
        "propertyNames": {
          "type": "string"
        },
        "type": "object"
      },
      "target": {
        "minLength": 1,
        "type": "string"
      },
      "title": {
        "$ref": "#/$defs/__schema0",
        "description": "新页面标题；省略时沿用此操作默认的副本标题。"
      }
    },
    "required": [
      "target",
      "replacements"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "参考页面改写",
    "targetKinds": [
      "course-surface"
    ]
  },
  "name": "surface.remix",
  "version": 1
}
