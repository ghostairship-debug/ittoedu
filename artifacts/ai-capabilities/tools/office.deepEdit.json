          },
          "relationships": {
            "$ref": "#/$defs/__schema21",
            "description": "由新对象 XML 引用的新关系。ID 在对象所在部件内唯一，内部 Target 相对于该部件。"
          },
          "removeParts": {
            "$ref": "#/$defs/__schema23",
            "description": "删除原目标依赖图中已不再被任何关系引用的包内部件。"
          },
          "removeRelationships": {
            "$ref": "#/$defs/__schema22",
            "description": "删除原目标节点曾引用且改后没有其他节点引用的关系 ID。"
          }
        },
        "type": "object"
      },
      "__schema14": {
        "items": {
