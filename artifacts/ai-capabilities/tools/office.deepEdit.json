        "minLength": 1,
        "type": "string"
      },
      "__schema33": {
        "additionalProperties": false,
        "properties": {
          "cell": {
            "pattern": "^[A-Z]{1,3}[1-9][0-9]*$",
            "type": "string"
          },
          "sheet": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "sheet",
          "cell"
        ],
        "type": "object"
      },
      "__schema34": {
        "$ref": "#/$defs/__schema35",
        "description": "Excel 原生数字格式代码，例如 0.0%。"
      },
      "__schema35": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[\\u0020-\\ud7ff\\ue000-\\ufffd\\u{10000}-\\u{10ffff}]+$",
