        "description": "从对象根逐级定位现有原生节点。空数组定位对象根。替换父节点即可新增或调整其子节点。",
        "items": {
          "$ref": "#/$defs/__schema7"
        },
        "type": "array"
      },
      "__schema7": {
        "additionalProperties": false,
        "properties": {
          "index": {
            "$ref": "#/$defs/__schema8",
            "default": 0,
            "description": "同命名空间且同名的直接子级中的零基序号"
          },
          "name": {
            "description": "原生 XML 直接子级的限定名称，沿用读取时的命名空间前缀",
            "pattern": "^(?:[a-zA-Z_][a-zA-Z_0-9.-]*:)?[a-zA-Z_][a-zA-Z_0-9.-]*$",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "__schema8": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "__schema9": {
        "anyOf": [
          {
            "$ref": "#/$defs/__schema10"
          },
          {
            "type": "null"
          }
        ],
        "description": "原生 XML 替换内容。null 删除目标节点。"
