{
  "description": "局部修改现有 Office 原文件。content 只表达要改的内容，软件保留其他文本、版式和媒体并保存原格式；可用唯一 oldText 或 inspect 提供的位置。先 inspect 后修改，软件自动沿用本任务读取的文件版本；expectedVersion 可省略，提供时要求当前版本一致。Excel 公式实际计算；不支持的公式保留并返回局部诊断。",
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "anyOf": [
          {
            "properties": {
              "index": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "paragraph",
                "type": "string"
              }
            },
            "required": [
              "type",
              "index",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "column": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "row": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "table": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "tableCell",
                "type": "string"
              }
            },
            "required": [
              "type",
              "table",
              "row",
              "column",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "oldText": {
                "minLength": 1,
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "replaceText",
                "type": "string"
              }
            },
            "required": [
              "type",
              "oldText",
              "text"
            ],
            "type": "object"
          }
        ]
      },
      "__schema1": {
        "properties": {
          "cell": {
            "pattern": "^[A-Z]{1,3}[1-9][0-9]*$",
            "type": "string"
          },
          "sheet": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "properties": {
                  "formula": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "formula"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "sheet",
          "cell",
          "value"
        ],
        "type": "object"
      },
      "__schema10": {
        "$ref": "#/$defs/__schema11",
        "description": "原样沿用 inspect 返回的 partVersion，不能自行生成或复用旧值"
      },
      "__schema11": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "__schema12": {
        "type": "string"
      },
      "__schema13": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "__schema2": {
        "properties": {
          "paragraph": {
            "$ref": "#/$defs/__schema13"
          },
          "part": {
            "$ref": "#/$defs/__schema8"
          },
          "partVersion": {
            "$ref": "#/$defs/__schema10"
          },
          "shape": {
            "$ref": "#/$defs/__schema4"
          },
          "shapeId": {
            "$ref": "#/$defs/__schema6"
          },
          "slide": {
            "$ref": "#/$defs/__schema3"
          },
          "text": {
            "$ref": "#/$defs/__schema12"
          }
        },
        "required": [
          "slide",
          "text"
        ],
        "type": "object"
      },
      "__schema3": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "__schema4": {
        "$ref": "#/$defs/__schema5",
        "description": "兼容按唯一名称定位；重名时请使用 inspect 返回的 shapeId"
      },
      "__schema5": {
        "type": "string"
      },
      "__schema6": {
        "$ref": "#/$defs/__schema7",
        "description": "inspect 返回的原件形状标识；提供时优先于名称定位"
      },
      "__schema7": {
        "minLength": 1,
        "type": "string"
      },
      "__schema8": {
        "$ref": "#/$defs/__schema9",
        "description": "原样沿用 inspect 返回的幻灯片 part，防止幻灯片顺序变化后误改"
      },
      "__schema9": {
        "minLength": 1,
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "content": {
        "oneOf": [
          {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/__schema0"
                },
                "minItems": 1,
                "type": "array"
              },
              "format": {
                "const": "docx",
                "type": "string"
              }
            },
            "required": [
              "format",
              "edits"
            ],
            "type": "object"
          },
          {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/__schema1"
                },
                "minItems": 1,
                "type": "array"
              },
              "format": {
                "const": "xlsx",
                "type": "string"
              }
            },
            "required": [
              "format",
              "edits"
            ],
            "type": "object"
          },
          {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/__schema2"
                },
                "minItems": 1,
                "type": "array"
              },
              "format": {
                "const": "pptx",
                "type": "string"
              }
            },
            "required": [
              "format",
              "edits"
            ],
            "type": "object"
          }
        ]
      },
      "expectedVersion": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "maxLength": 32767,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "path",
      "content"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "office.edit",
    "targetKinds": []
  },
  "name": "office.edit",
  "version": 1
}
