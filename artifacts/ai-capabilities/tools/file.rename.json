{
  "description": "重命名文件或文件夹，已打开文档的路径绑定由宿主协调；不默认覆盖。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "name": {
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "maxLength": 32767,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "path",
      "name"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "name": "file.rename",
  "version": 1
}
