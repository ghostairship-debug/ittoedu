        "additionalProperties": false,
        "properties": {
          "authoringAddress": {
            "$ref": "#/$defs/__schema1"
          },
          "documentRevision": {
            "$ref": "#/$defs/__schema2"
          },
          "itemId": {
            "$ref": "#/$defs/__schema1"
          },
          "locationId": {
            "$ref": "#/$defs/__schema1"
          },
          "owner": {
            "enum": [
              "global",
              "surface",
              "scene",
              "world"
            ],
            "type": "string"
          },
          "ownerKey": {
            "$ref": "#/$defs/__schema1"
          },
          "projectId": {
            "$ref": "#/$defs/__schema1"
          },
          "revisionPolicy": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "exact",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "sessionGeneration": {
            "$ref": "#/$defs/__schema2"
          },
          "stateId": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ]
          },
          "surfaceId": {
            "$ref": "#/$defs/__schema1"
          },
          "surfaceType": {
            "enum": [
              "slide",
              "flow",
              "spatial-2d"
            ],
            "type": "string"
          }
        },
        "required": [
          "projectId",
          "documentRevision",
          "revisionPolicy",
          "sessionGeneration",
          "surfaceType",
          "surfaceId",
          "locationId",
          "stateId",
          "owner",
          "ownerKey",
          "itemId",
          "authoringAddress"
        ],
        "type": "object"
      },
      "__schema1": {
        "minLength": 1,
        "type": "string"
      },
      "__schema2": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "reorder",
            "type": "string"
          },
          "position": {
            "oneOf": [
              {
