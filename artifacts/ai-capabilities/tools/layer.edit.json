                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "back",
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "before",
                    "type": "string"
                  },
                  "siblingId": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "siblingId"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "after",
                    "type": "string"
                  },
                  "siblingId": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "siblingId"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "operation",
          "position"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "duplicate",
            "type": "string"
          },
          "placement": {
            "additionalProperties": false,
            "properties": {
              "gap": {
                "minimum": 0,
                "type": "number"
              },
              "side": {
                "enum": [
                  "right",
                  "left",
                  "above",
                  "below"
                ],
                "type": "string"
              }
            },
            "required": [
              "side",
              "gap"
            ],
            "type": "object"
          }
        },
        "required": [
          "operation",
          "placement"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "left",
              "center",
              "right",
              "top",
              "middle",
              "bottom"
            ],
            "type": "string"
          },
          "operation": {
            "const": "align",
            "type": "string"
          },
          "primaryTarget": {
            "$ref": "#/$defs/__schema0"
          },
          "targets": {
            "items": {
              "$ref": "#/$defs/__schema0"
            },
            "maxItems": 200,
            "minItems": 2,
            "type": "array"
          }
        },
        "required": [
          "operation",
          "targets",
          "mode"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "axis": {
            "enum": [
              "horizontal",
              "vertical"
            ],
            "type": "string"
          },
          "operation": {
            "const": "distribute",
            "type": "string"
          },
          "targets": {
            "items": {
              "$ref": "#/$defs/__schema0"
            },
            "maxItems": 200,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "operation",
          "targets",
          "axis"
        ],
        "type": "object"
      }
    ]
