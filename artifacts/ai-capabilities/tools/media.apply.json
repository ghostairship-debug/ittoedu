{
  "description": "使用来源返回的 source 或已授权文件路径，原位替换同类型图片、音频或视频；软件读取实际字节并登记资源。保留对象身份、frame、专业效果与未指定字段；asset 可引用当前文档已有图片句柄。",
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "__schema1": {
        "enum": [
          "contain",
          "cover",
          "stretch"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "additionalProperties": false,
        "properties": {
          "fit": {
            "$ref": "#/$defs/__schema1"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "target",
          "source"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "fit": {
            "$ref": "#/$defs/__schema1"
          },
          "resource": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "target",
          "resource"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "asset": {
            "$ref": "#/$defs/__schema0"
          },
          "fit": {
            "$ref": "#/$defs/__schema1"
          },
          "target": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "target",
          "asset"
        ],
        "type": "object"
      }
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "edit",
    "label": "替换媒体",
    "targetKinds": [
      "course-instance"
    ]
  },
  "name": "media.apply",
  "version": 1
}
