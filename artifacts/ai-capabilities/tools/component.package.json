{
  "candidateCarrier": {
    "default": "generated-component"
  },
  "description": "修改现有源码优先 patch：提供精确 basePackageId/baseVersion/baseContentIdentity、仅改变的 changedFiles、显式 deleteFiles；宿主补齐未变文件并校验完整包。mode:shared 使用 global package update target 修改所有实例；mode:instance 使用精确组件实例 update target，宿主另存副本仅重绑此实例。不得自行改 manifest ID/版本。公开参数足够时用 component.configure；完整 files revise 保持兼容。",
  "examples": [
    {
      "bindings": "baseline 来自当前完整源码描述的 packageId/baseVersion/baseContentIdentity；changedFiles 只含实际改动文件；target 原样取对应模式的当前 target。",
      "code": "const input={operation:\"patch\",mode:\"shared\",basePackageId:baseline.packageId,baseVersion:baseline.baseVersion,baseContentIdentity:baseline.baseContentIdentity,changedFiles,deleteFiles:[]}; const receipt=await session.execute(\"component.package\",input,{kind:\"update\",target});",
      "mode": "shared",
      "operation": "patch"
    },
    {
      "bindings": "baseline 来自当前完整源码描述的 packageId/baseVersion/baseContentIdentity；changedFiles 只含实际改动文件；target 原样取对应模式的当前 target。",
      "code": "const input={operation:\"patch\",mode:\"instance\",basePackageId:baseline.packageId,baseVersion:baseline.baseVersion,baseContentIdentity:baseline.baseContentIdentity,changedFiles,deleteFiles:[]}; const receipt=await session.execute(\"component.package\",input,{kind:\"update\",target});",
      "mode": "instance",
      "operation": "patch"
    },
    {
      "bindings": "baseline 为当前源码基线；files 为完整包文件；target 为当前 global package target。",
      "code": "const receipt=await session.execute(\"component.package\",{operation:\"revise\",baseVersion:baseline.baseVersion,baseContentIdentity:baseline.baseContentIdentity,files},{kind:\"update\",target});",
      "operation": "revise"
    },
    {
      "bindings": "files 为完整合法包文件；target 为当前 global package target。",
      "code": "const receipt=await session.execute(\"component.package\",{operation:\"replace\",files},{kind:\"update\",target});",
      "operation": "replace"
    }
  ],
  "inputSchema": {
    "$defs": {
      "__schema0": {
        "additionalProperties": {
          "anyOf": [
            {
              "maxLength": 24000000,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "encoding": {
                  "const": "utf8",
                  "type": "string"
                },
                "text": {
                  "maxLength": 18000000,
                  "type": "string"
                }
              },
              "required": [
                "encoding",
                "text"
              ],
              "type": "object"
            }
          ]
        },
        "propertyNames": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "type": "object"
      },
      "__schema1": {
        "const": "patch",
        "type": "string"
      },
      "__schema2": {
        "enum": [
          "shared",
          "instance"
        ],
        "type": "string"
      },
      "__schema3": {
        "minLength": 1,
        "type": "string"
      },
      "__schema4": {
        "minLength": 1,
        "type": "string"
      },
      "__schema5": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "__schema6": {
        "items": {
          "$ref": "#/$defs/__schema7"
        },
        "maxItems": 512,
        "type": "array"
      },
      "__schema7": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "files": {
            "$ref": "#/$defs/__schema0"
          },
          "operation": {
            "const": "replace",
            "type": "string"
          }
        },
        "required": [
          "operation",
          "files"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "baseContentIdentity": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "baseVersion": {
            "minLength": 1,
            "type": "string"
          },
          "files": {
            "$ref": "#/$defs/__schema0"
          },
          "operation": {
            "const": "revise",
            "type": "string"
          }
        },
        "required": [
          "operation",
          "baseVersion",
          "baseContentIdentity",
          "files"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "baseContentIdentity": {
            "$ref": "#/$defs/__schema5"
          },
          "basePackageId": {
            "$ref": "#/$defs/__schema3"
          },
          "baseVersion": {
            "$ref": "#/$defs/__schema4"
          },
          "changedFiles": {
            "$ref": "#/$defs/__schema0"
          },
          "deleteFiles": {
            "$ref": "#/$defs/__schema6"
          },
          "mode": {
            "$ref": "#/$defs/__schema2"
          },
          "operation": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "operation",
          "mode",
          "basePackageId",
          "baseVersion",
          "baseContentIdentity",
          "changedFiles",
          "deleteFiles"
        ],
        "type": "object"
      }
    ]
  },
  "invocation": "Builder: await session.execute(tool,input,destination)。input 遵循本卡完整 Schema；destination 原样使用当前 observe/createScope 的目标；只以 committed receipt 判定成功。",
  "name": "component.package",
  "recovery": "invalid-input: 按本卡 Schema 修正字段；revision-conflict: 重新 observe 后复制新 target 和源码基线；tool-failed: 读取 diagnostics 修复所指输入/资源/宿主条件，失败不代表已提交。",
  "support": "conditional-on-input-target-resources-and-host",
  "supportedScopes": [
    "slide:global",
    "flow:global",
    "spatial-2d:global",
    "slide:scene",
    "slide:surface",
    "flow:surface",
    "spatial-2d:world",
    "spatial-2d:surface"
  ],
  "variants": [
    {
      "operation": "replace",
      "scopes": [
        "slide:global",
        "flow:global",
        "spatial-2d:global"
      ],
      "target": "update: 精确 global package target；影响此包的所有实例。"
    },
    {
      "operation": "revise",
      "scopes": [
        "slide:global",
        "flow:global",
        "spatial-2d:global"
      ],
      "target": "update: 精确 global package target；基线须为当前版本；影响此包的所有实例。"
    },
    {
      "mode": "shared",
      "operation": "patch",
      "scopes": [
        "slide:global",
        "flow:global",
        "spatial-2d:global"
      ],
      "target": "update: 当前源码描述的 shared target；修改此包的所有实例。"
    },
    {
      "mode": "instance",
      "operation": "patch",
      "scopes": [
        "slide:scene",
        "slide:surface",
        "slide:global",
        "flow:surface",
        "flow:global",
        "spatial-2d:world",
        "spatial-2d:surface",
        "spatial-2d:global"
      ],
      "target": "update: 当前源码描述的精确组件实例 target；stateId 必须为 null；另存副本只重绑此实例。"
    }
  ],
  "version": 1
}
