                          "propertyNames": {
                            "type": "string"
                          },
                          "type": "object"
                        },
                        "visible": {
                          "type": "boolean"
                        }
                      },
                      "type": "object"
                    },
                    "target": {
                      "maxLength": 100,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "target",
                    "properties"
                  ],
                  "type": "object"
                },
                "name": {
