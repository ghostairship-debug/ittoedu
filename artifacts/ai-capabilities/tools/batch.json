                        },
                        "target": {
                          "maxLength": 100,
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "target",
                        "resource"
                      ],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
