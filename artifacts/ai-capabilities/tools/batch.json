                                        "minLength": 1,
                                        "type": "string"
                                      },
                                      "type": "array"
                                    },
                                    "kind": {
                                      "const": "source",
                                      "type": "string"
                                    },
                                    "language": {
                                      "enum": [
                                        "javascript",
                                        "typescript"
                                      ],
                                      "type": "string"
                                    },
                                    "moduleBindings": {
                                      "additionalProperties": {
                                        "minLength": 1,
                                        "type": "string"
                                      },
                                      "propertyNames": {
                                        "minLength": 1,
                                        "type": "string"
                                      },
                                      "type": "object"
                                    },
                                    "resourceBindings": {
