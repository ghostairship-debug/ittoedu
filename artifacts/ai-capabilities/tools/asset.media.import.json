{
  "candidateCarrier": {
    "default": "native"
  },
  "description": "导入素材依赖，使用 global owner + create parent:owner append。base64 为真实媒体字节。新 asset ID 从该步骤回执的 asset-id 引用获得，不能自行指定。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "base64": {
        "maxLength": 90000000,
        "minLength": 1,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
        "type": "string"
      },
      "filename": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "enum": [
          "image",
          "audio",
          "video"
        ],
        "type": "string"
      },
      "mimeType": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "kind",
      "filename",
      "mimeType",
      "base64"
    ],
    "type": "object"
  },
  "name": "asset.media.import",
  "support": "conditional-on-input-target-resources-and-host",
  "supportedScopes": [
    "slide:global",
    "flow:global",
    "spatial-2d:global"
  ],
  "version": 1
}
