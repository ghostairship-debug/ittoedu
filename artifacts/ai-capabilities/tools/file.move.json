{
  "description": "把 sources 移动到 destination 文件夹，已打开文档的路径绑定由宿主协调；逐项返回结果。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "destination": {
        "maxLength": 32767,
        "minLength": 1,
        "type": "string"
      },
      "sources": {
        "items": {
          "maxLength": 32767,
          "minLength": 1,
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "sources",
      "destination"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "name": "file.move",
  "version": 1
}
