            },
            "type": "array"
          },
          "header": {
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "rows": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  {
                    "properties": {
                      "formula": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "formula"
                    ],
                    "type": "object"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "rows"
        ],
        "type": "object"
      },
      "__schema3": {
        "properties": {
          "body": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "notes": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "content": {
        "oneOf": [
          {
            "properties": {
