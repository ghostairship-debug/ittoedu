                },
                "minItems": 1,
                "type": "array"
              },
              "type": {
                "const": "table",
                "type": "string"
              }
            },
            "required": [
              "type",
              "rows"
            ],
            "type": "object"
          }
        ]
      },
      "__schema1": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "__schema2": {
        "properties": {
          "columnWidths": {
            "items": {
              "exclusiveMinimum": 0,
