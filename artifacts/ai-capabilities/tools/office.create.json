                    },
                    "italic": {
                      "type": "boolean"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "paragraph",
