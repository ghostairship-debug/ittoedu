                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "format",
              "slides"
            ],
            "type": "object"
          }
        ]
      },
      "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "path": {
        "maxLength": 32767,
        "minLength": 1,
        "type": "string"
      }
