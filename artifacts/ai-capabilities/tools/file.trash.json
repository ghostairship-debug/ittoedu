{
  "description": "把指定文件或文件夹移入系统回收站；逐项返回结果，不永久删除。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "paths": {
        "items": {
          "maxLength": 32767,
          "minLength": 1,
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "paths"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "name": "file.trash",
  "version": 1
}
