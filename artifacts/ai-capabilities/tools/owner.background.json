{
  "candidateCarrier": {
    "default": "native"
  },
  "examples": [
    {
      "input": {
        "backgroundColor": "#ffffff"
      }
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "backgroundAssetId": {
        "anyOf": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "backgroundColor": {
        "pattern": "^#[0-9a-fA-F]{6}$",
        "type": "string"
      },
      "backgroundMode": {
        "enum": [
          "inherit",
          "own"
        ],
        "type": "string"
      }
    },
    "type": "object"
  },
  "invocation": "Builder: await session.execute(tool,input,destination)。input 遵循本卡完整 Schema；destination 原样使用当前 observe/createScope 的目标；只以 committed receipt 判定成功。",
  "name": "owner.background",
  "recovery": "invalid-input: 按本卡 Schema 修正字段；revision-conflict: 重新 observe 后复制新 target 和源码基线；tool-failed: 读取 diagnostics 修复所指输入/资源/宿主条件，失败不代表已提交。",
  "support": "conditional-on-input-target-resources-and-host",
  "supportedScopes": [
    "slide:scene",
    "slide:surface",
    "slide:global",
    "flow:surface",
    "flow:global",
    "spatial-2d:surface",
    "spatial-2d:global"
  ],
  "variants": [
    {
      "scopes": [
        "slide:scene",
        "slide:surface",
        "slide:global",
        "flow:surface",
        "flow:global",
        "spatial-2d:surface",
        "spatial-2d:global"
      ]
    }
  ],
  "version": 1
}
