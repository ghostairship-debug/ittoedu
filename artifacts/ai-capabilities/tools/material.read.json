{
  "description": "读取授权材料，软件按需准备并缓存所需页段，无需先 material.extract。attachmentId 用原材料；可指定 pages 和 representation=text/image，省略时优先正文。representationId 只用于回读明确命中的表示。返回真实出处、缺口及未读页段；截断后将 nextCursor 传给 cursor，仍使用同一原材料。图片进入下一轮输入，准备好图片不表示模型已理解。不会自动全件 OCR 或执行文件内容。",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "attachmentId": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
      },
      "cursor": {
        "minLength": 1,
        "type": "string"
      },
      "maxChars": {
        "default": 6000,
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "pages": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "to": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "representation": {
        "default": "auto",
        "enum": [
          "auto",
          "text",
          "image"
        ],
        "type": "string"
      },
      "representationId": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "attachmentId"
    ],
    "type": "object"
  },
  "invocation": "静态目录只说明已登记接口；当前运行是否可调用、文档范围、写权限、短句柄和服务配置，以宿主本轮发现与实际回执为准。",
  "manual": {
    "group": "read",
    "label": "读取材料",
    "targetKinds": []
  },
  "name": "material.read",
  "version": 1
}
